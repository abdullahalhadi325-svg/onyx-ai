# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Onyx Supabase & Cloudflare Worker Configuration (Vite client env vars)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_BACKEND_API_URL="https://hadi-mp-ai-backend.abdullahalhadi325.workers.dev"

# Optional Silent Telegram Developer Telemetry & Admin PIN Hash (configure in Admin Panel or env)
VITE_TELEGRAM_BOT_TOKEN=""
VITE_TELEGRAM_CHAT_ID=""
VITE_ADMIN_PIN_HASH=""
